# Snowflake connection for `sfestimate check` and `sfestimate calibrate`.
# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. Never commit it or your private key.

# Account identifier in orgname-accountname form (not the full URL).
SNOWFLAKE_ACCOUNT=myorg-myaccount

# The Snowflake user you registered the public key on (see `sfestimate keygen`).
SNOWFLAKE_USER=MY_USER

# Path to the PKCS#8 private key created by `sfestimate keygen`.
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8

# Role used for the session. Needs privileges to create warehouses for calibration.
# ACCOUNTADMIN is the usual choice on a trial account.
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Optional: warehouse for `sfestimate check`. Calibration creates its own
# (--warehouse, default SFESTIMATE_CALIBRATION_WH).
SNOWFLAKE_WAREHOUSE=
